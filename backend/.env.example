# Backend Environment Variables for Render Deployment

# Database Configuration (Render PostgreSQL will provide this automatically)
DATABASE_URL=postgresql://username:password@host:port/database

# Security (REQUIRED in production - use Render's environment variable generator)
SECRET_KEY=your-production-secret-key-here

# CORS Configuration (Frontend domain for production)
CORS_ORIGINS=https://your-frontend-domain.onrender.com

# Frontend URL (used for CORS fallback)
FRONTEND_URL=https://your-frontend-domain.onrender.com

# Application Port (Render will set this automatically)
PORT=10000

# Environment indicator (Render sets this automatically)
RENDER=true