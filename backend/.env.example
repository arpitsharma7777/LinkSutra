# Backend Environment Variables for Railway Deployment

# Database Configuration (Railway PostgreSQL will provide this automatically)
DATABASE_URL=postgresql://username:password@host:port/database

# Security
SECRET_KEY=your-production-secret-key-here

# CORS Configuration (Frontend domain for production)
CORS_ORIGINS=https://your-frontend-domain.railway.app,https://your-custom-domain.com

# Application Port (Railway will set this automatically)
PORT=8000